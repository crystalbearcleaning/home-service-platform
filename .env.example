# =========================================================================
# Home Service Operating Platform — Phase 1 environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env or .env.local.
# =========================================================================

# -----------------------------
# Supabase
# -----------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------
# Google Places / Geocoding
# Browser key must be domain-restricted in the Google Cloud console.
# -----------------------------
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# -----------------------------
# RentCast (server-side only — never expose to the browser)
# -----------------------------
RENTCAST_API_KEY=

# -----------------------------
# Seed / bootstrap
# Used by the seed script to link the first admin user to Crystal Bear.
# The user must sign up via Supabase Auth first, then rerun the seed.
# -----------------------------
SEED_ADMIN_EMAIL=

# Optional: seeds Sam as the initial Phase 3 notification recipient.
# Format: E.164 (e.g. +15615551234). Leave blank to skip — the three
# message automations still seed; the recipient can be added later.
SEED_NOTIFICATION_PHONE_E164=

# -----------------------------
# GoHighLevel — Phase 3 SMS provider (server-side only).
# All four values are read by the future GHL adapter (Phase 3C). Phase 3B
# does NOT call GoHighLevel; these keys may stay blank until Phase 3C
# wires the adapter. Never expose any of these to the browser.
# -----------------------------
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_FROM_PHONE_NUMBER=
GHL_BASE_URL=

# -----------------------------
# Default domain resolution for localhost / Vercel previews.
# Production custom domains are resolved via the app_surface_domains table.
# -----------------------------
DEFAULT_BUSINESS_SLUG=crystal-bear
DEFAULT_CUSTOMER_QUOTE_SURFACE_SLUG=quote

# -----------------------------
# Staging tools gate.
# The staging reset button only renders when the public flag is true,
# and the server action only runs when the server flag is true.
# Never set either to "true" in production.
# -----------------------------
NEXT_PUBLIC_ENABLE_STAGING_TOOLS=false
ENABLE_STAGING_TOOLS=false
